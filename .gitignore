# Local .terraform directories
**/.terraform/*

# .tfstate files (CRITICAL: State files contain sensitive data and secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with secrets
*.tfvars
*.tfvars.json

# Always allow example tfvars for documentation
!*.example.tfvars
!example.tfvars

# CLI configuration files
.terraformrc
terraform.rc

# OS & Editor cache
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
