# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example tfvars for documentation
!*.example.tfvars
!example.tfvars

# CLI configuration files
.terraformrc
terraform.rc

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
